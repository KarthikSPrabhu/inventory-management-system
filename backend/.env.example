# Server configuration
PORT=5000
NODE_ENV=development

# Database configuration (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/<db-name>?retryWrites=true&w=majority

# JWT Authentication configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated list or dynamic LAN matching)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
